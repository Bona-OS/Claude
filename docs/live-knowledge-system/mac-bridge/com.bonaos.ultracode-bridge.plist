<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bonaos.ultracode-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/bonaos/wiki/control/cloud-bridge/drive-command-watcher.sh</string>
    </array>
    <!-- Poll a cada 5 min. Para gatilho por arquivo local (Drive Desktop), troque por WatchPaths. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/bonaos/wiki/control/cloud-bridge/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bonaos/wiki/control/cloud-bridge/launchd.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
