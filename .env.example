# ==========================================================================
# FotoRestaura — variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA comite o .env.local de verdade.
# ==========================================================================

# --- Restauração de imagem (Google Gemini / "Nano Banana") --------------
# Crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo de imagem. "Nano Banana" = gemini-2.5-flash-image.
# Para a versão Pro/2, troque pelo ID correspondente quando tiver acesso.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Geração de mídia (xAI Grok — conector MCP em mcp/grok-media) -------
# Crie em https://console.x.ai — a assinatura SuperGrok Heavy NÃO inclui
# acesso à API; os créditos de API são separados.
XAI_API_KEY=

# --- Banco de dados + storage (Supabase) --------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=photos

# --- WhatsApp Cloud API (Meta) ------------------------------------------
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que VOCÊ inventa e repete no painel da Meta ao configurar o webhook.
WHATSAPP_VERIFY_TOKEN=fotorestaura-webhook

# --- Pagamento (Mercado Pago / Pix) -------------------------------------
# https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=

# --- Produto / preço -----------------------------------------------------
PRICE_BRL=29

# --- Landing page (público) ---------------------------------------------
# Link wa.me do seu número, ex: https://wa.me/5511999999999
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/0000000000
NEXT_PUBLIC_BRAND=FotoRestaura
