# ==========================================================================
# Forneria Paulistana — variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA comite o .env.local de verdade.
# ==========================================================================

# --- Banco de dados (Supabase / Postgres) -------------------------------
# Crie o projeto em https://supabase.com e rode supabase/migrations/0001_init.sql.
# Sem essas chaves o site roda em modo demonstração (pedidos ficam só em memória).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pagamento (Mercado Pago / Pix) -------------------------------------
# https://www.mercadopago.com.br/developers/panel/app
# Sem MP_ACCESS_TOKEN o pagamento por Pix fica indisponível e o cliente
# só consegue escolher "pagar na entrega".
MP_ACCESS_TOKEN=

# URL pública do site (usada para montar o webhook de confirmação do Pix).
# Em produção, algo como https://forneriapaulistana.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Loja (público) ------------------------------------------------------
# Número no formato internacional só com dígitos (para o link wa.me).
NEXT_PUBLIC_WHATSAPP=5548999990000
NEXT_PUBLIC_BRAND=Forneria Paulistana
