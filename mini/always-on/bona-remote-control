#!/usr/bin/env bash
# bona-remote-control — mantém o Remote Control do Mini de pé. Roda sob o LaunchAgent
# ai.bona.remote-control (KeepAlive): se o processo cair, o launchd sobe de novo em segundos.
# Por quê: em modo servidor, `claude remote-control` desiste depois de ~10 min sem rede (ou com o
# Mac dormindo) e sai sem reconectar; as sessões ficam «em execução» no app, mas mudas. Reiniciado
# em até ~4 h, ele traz de volta as sessões que servia. Doc: code.claude.com/docs/en/remote-control
set -uo pipefail

DIR="${BONA_RC_DIR:-$HOME/Bona-OS/Claude}"
NAME="${BONA_RC_NAME:-Bona Mini}"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# Remote Control exige o login claude.ai completo; token de inferência ou chave de API atrapalham.
unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY

ts() { date -u +%FT%TZ; }
cd "$DIR" || { echo "$(ts) BLOQUEIO: pasta ausente: $DIR"; sleep 60; exit 1; }
command -v claude >/dev/null || { echo "$(ts) BLOQUEIO: claude não instalado"; sleep 60; exit 1; }

echo "$(ts) iniciando remote-control em $DIR ($(claude --version))"
# caffeinate: impede o sono do sistema enquanto o servidor roda (-i ocioso, -s na tomada, -m disco).
exec caffeinate -ims claude remote-control --name "$NAME" --verbose
